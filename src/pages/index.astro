---
import '../styles/global.css';

const projects = [
  {
    index: '01',
    title: 'KARUNIA',
    eyebrow: 'Operational system',
    description:
      'A connected workflow across ordering, stock allocation, mapping, transactions, and realtime operational visibility.',
    tags: ['ERP', 'Realtime', 'Operations'],
    tone: 'violet',
  },
  {
    index: '02',
    title: 'ERP Distributor',
    eyebrow: 'Enterprise platform',
    description:
      'A multi-entity ERP covering warehouse, finance, AR/AP, intercompany flows, and consolidated reporting.',
    tags: ['Multi-entity', 'Finance', 'Warehouse'],
    tone: 'cyan',
  },
  {
    index: '03',
    title: 'Aurora POS',
    eyebrow: 'Retail experience',
    description:
      'A fast POS and back-office experience designed around modular workflows, clarity, and operational speed.',
    tags: ['POS', 'Back Office', 'UX'],
    tone: 'amber',
  },
  {
    index: '04',
    title: 'iInvitation',
    eyebrow: 'Digital experience',
    description:
      'A polished invitation platform pairing expressive front-end experiences with a practical operational back office.',
    tags: ['Web', 'Experience', 'Workflow'],
    tone: 'rose',
  },
];

const capabilities = [
  'Product Strategy',
  'Project Delivery',
  'ERP & Operations',
  'Business Process',
  'UI / UX Direction',
  'System Thinking',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <meta
      name="description"
      content="Arga Dikusuma — Project Manager focused on digital products, operational systems, and thoughtful user experiences."
    />
    <meta property="og:title" content="Arga Dikusuma — Portfolio" />
    <meta
      property="og:description"
      content="Selected work across digital products, ERP, operations, and user experience."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://isargadikusuma.github.io" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Arga Dikusuma — Portfolio</title>
  </head>

  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>

    <header class="site-header" data-header>
      <a class="brand" href="#top" aria-label="Arga Dikusuma, back to top">
        <span class="brand-mark" aria-hidden="true">AD</span>
        <span class="brand-copy">
          <strong>Arga Dikusuma</strong>
          <small>Project Manager</small>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#capabilities">Capabilities</a>
      </nav>

      <a
        class="header-cta"
        href="https://github.com/isargadikusuma"
        target="_blank"
        rel="noreferrer"
      >
        GitHub
        <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="top">
      <section class="hero section-shell">
        <div class="hero-copy" data-reveal>
          <div class="availability-pill">
            <span class="availability-dot"></span>
            Designing clearer systems
          </div>

          <h1>
            I turn tangled
            <span class="hero-accent">operations</span>
            into clear digital systems.
          </h1>

          <p class="hero-lede">
            Project manager working where product, process, technology, and user
            experience meet. I shape complex workflows into products people can
            actually understand and use.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#work">
              Explore selected work
              <span aria-hidden="true">↓</span>
            </a>
            <a
              class="button button-ghost"
              href="https://github.com/isargadikusuma"
              target="_blank"
              rel="noreferrer"
            >
              GitHub profile
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-label="An abstract system workflow visual" data-reveal>
          <div class="visual-orbit orbit-one"></div>
          <div class="visual-orbit orbit-two"></div>
          <div class="system-card system-main">
            <div class="system-topline">
              <span>System map</span>
              <span class="status-live"><i></i> Live</span>
            </div>

            <div class="system-core">
              <div class="core-icon">A</div>
              <div>
                <small>Orchestrating</small>
                <strong>Product × Operations</strong>
              </div>
            </div>

            <div class="system-flow">
              <div class="flow-item">
                <span class="flow-number">01</span>
                <div>
                  <strong>Understand</strong>
                  <small>Find the real problem</small>
                </div>
              </div>
              <span class="flow-line"></span>
              <div class="flow-item">
                <span class="flow-number">02</span>
                <div>
                  <strong>Structure</strong>
                  <small>Make complexity legible</small>
                </div>
              </div>
              <span class="flow-line"></span>
              <div class="flow-item">
                <span class="flow-number">03</span>
                <div>
                  <strong>Ship</strong>
                  <small>Turn intent into outcomes</small>
                </div>
              </div>
            </div>
          </div>

          <div class="float-card float-card-a">
            <span class="float-icon">↗</span>
            <div>
              <small>Focus</small>
              <strong>Clarity</strong>
            </div>
          </div>

          <div class="float-card float-card-b">
            <span class="float-icon">◎</span>
            <div>
              <small>Method</small>
              <strong>Systems</strong>
            </div>
          </div>
        </div>

        <div class="hero-meta" data-reveal>
          <span>Based in Indonesia</span>
          <span class="hero-meta-line"></span>
          <span>Product · Operations · Technology</span>
        </div>
      </section>

      <section class="ticker" aria-label="Portfolio disciplines">
        <div class="ticker-track">
          {[...capabilities, ...capabilities].map((item) => (
            <span>
              {item}
              <i aria-hidden="true">✦</i>
            </span>
          ))}
        </div>
      </section>

      <section class="work section-shell" id="work">
        <div class="section-heading" data-reveal>
          <div>
            <span class="section-kicker">Selected work</span>
            <h2>Projects built around real operational problems.</h2>
          </div>
          <p>
            A selection of systems and product experiences spanning ERP,
            transactional workflows, retail, and digital experiences.
          </p>
        </div>

        <div class="projects-grid">
          {projects.map((project, projectIndex) => (
            <article class={`project-card project-${project.tone}`} data-reveal>
              <div class="project-meta">
                <span>{project.index}</span>
                <span>{project.eyebrow}</span>
              </div>

              <div class="project-preview" aria-hidden="true">
                <div class="preview-window">
                  <div class="preview-bar">
                    <span></span><span></span><span></span>
                    <i></i>
                  </div>

                  {projectIndex === 0 && (
                    <div class="preview-karunia">
                      <aside>
                        <span></span><span></span><span></span><span></span>
                      </aside>
                      <div class="preview-content">
                        <div class="preview-title"></div>
                        <div class="preview-columns">
                          <div class="preview-panel">
                            <i></i><i></i><i></i>
                          </div>
                          <div class="preview-panel preview-panel-wide">
                            <b></b><b></b><b></b><b></b>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}

                  {projectIndex === 1 && (
                    <div class="preview-erp">
                      <div class="erp-sidebar"></div>
                      <div class="erp-main">
                        <div class="erp-metrics">
                          <span></span><span></span><span></span>
                        </div>
                        <div class="erp-chart">
                          <i></i><i></i><i></i><i></i><i></i><i></i>
                        </div>
                      </div>
                    </div>
                  )}

                  {projectIndex === 2 && (
                    <div class="preview-pos">
                      <div class="pos-products">
                        <span></span><span></span><span></span><span></span>
                        <span></span><span></span>
                      </div>
                      <div class="pos-cart">
                        <i></i><i></i><i></i>
                        <b></b>
                      </div>
                    </div>
                  )}

                  {projectIndex === 3 && (
                    <div class="preview-invite">
                      <div class="invite-copy">
                        <small></small>
                        <strong></strong>
                        <strong class="short"></strong>
                        <i></i>
                      </div>
                      <div class="invite-card">
                        <span>∞</span>
                      </div>
                    </div>
                  )}
                </div>
              </div>

              <div class="project-copy">
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </div>
                <div class="project-tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about section-shell" id="about">
        <div class="about-grid">
          <div class="about-number" data-reveal>02</div>
          <div class="about-content" data-reveal>
            <span class="section-kicker">About</span>
            <p class="about-statement">
              I care about the invisible layer behind a good product:
              <em>the workflow, decisions, constraints, and details that make it feel obvious.</em>
            </p>
            <div class="about-details">
              <p>
                My work sits between business needs and implementation. I map
                processes, challenge unnecessary complexity, coordinate delivery,
                and keep the product experience coherent from the first decision to
                the final interaction.
              </p>
              <p>
                The goal is not to decorate complexity. It is to reduce it, expose
                what matters, and make the system feel calm even when the problem
                behind it is anything but.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="capabilities section-shell" id="capabilities">
        <div class="section-heading capabilities-heading" data-reveal>
          <div>
            <span class="section-kicker">Capabilities</span>
            <h2>From messy whiteboard to shipped workflow.</h2>
          </div>
        </div>

        <div class="capability-list">
          {capabilities.map((capability, index) => (
            <div class="capability-row" data-reveal>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{capability}</strong>
              <i aria-hidden="true">↗</i>
            </div>
          ))}
        </div>
      </section>

      <section class="closing section-shell" data-reveal>
        <div class="closing-card">
          <span class="section-kicker">Next</span>
          <h2>
            Good systems should feel
            <span>quietly obvious.</span>
          </h2>
          <p>
            More case studies are coming. For now, explore the work and code on
            GitHub.
          </p>
          <a
            class="button button-light"
            href="https://github.com/isargadikusuma"
            target="_blank"
            rel="noreferrer"
          >
            Visit GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer section-shell">
      <div>
        <strong>Arga Dikusuma</strong>
        <span>Project Manager · Product · Technology</span>
      </div>
      <div class="footer-links">
        <a href="#top">Back to top ↑</a>
        <a href="https://github.com/isargadikusuma" target="_blank" rel="noreferrer">
          GitHub ↗
        </a>
      </div>
    </footer>

    <script is:inline>
      const header = document.querySelector('[data-header]');
      const revealItems = document.querySelectorAll('[data-reveal]');

      const setHeaderState = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 16);
      };

      setHeaderState();
      window.addEventListener('scroll', setHeaderState, { passive: true });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }

      const heroVisual = document.querySelector('.hero-visual');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (heroVisual && !reduceMotion) {
        heroVisual.addEventListener('pointermove', (event) => {
          const rect = heroVisual.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          heroVisual.style.setProperty('--tilt-x', `${y * -4}deg`);
          heroVisual.style.setProperty('--tilt-y', `${x * 5}deg`);
          heroVisual.style.setProperty('--glow-x', `${event.clientX - rect.left}px`);
          heroVisual.style.setProperty('--glow-y', `${event.clientY - rect.top}px`);
        });

        heroVisual.addEventListener('pointerleave', () => {
          heroVisual.style.setProperty('--tilt-x', '0deg');
          heroVisual.style.setProperty('--tilt-y', '0deg');
        });
      }
    </script>
  </body>
</html>
